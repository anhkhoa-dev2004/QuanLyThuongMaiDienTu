<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!-- Máy khác thì sửa phần Data Source bên dưới cho giống ô Server Name khi mở SQL Server Management Studio (ví dụ: localhost, .\SQLEXPRESS, TENMAY\TENBANSQL). -->
	<configSections>
	</configSections>
	<connectionStrings>
		<add name="QuanLyThuongMaiDienTu"
             connectionString="Data Source=localhost;Initial Catalog=QuanLyThuongMaiDienTu;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
		<add name="QuanLy_BanHang_Kho_Shopee.Properties.Settings.QuanLyThuongMaiDienTuConnectionString"
             connectionString="Data Source=localhost;Initial Catalog=QuanLyThuongMaiDienTu;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
	<!-- GeminiApiKey: khóa dùng cho "Trợ lý AI hỏi dữ liệu" (lấy ở Google AI Studio). Để trống thì các chức năng khác vẫn chạy bình thường. -->
	<appSettings>
		<add key="GeminiApiKey" value="" />
		<add key="GeminiModel" value="gemini-2.5-flash" />
	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
</configuration>